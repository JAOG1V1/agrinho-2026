{
  "extends": ["development"],
  "hints": {
    "compat-api/html": "off",
    "compat-api/css": "off",
    "highest-available-document-mode": "off",
    "meta-viewport": "off",
    "meta-charset-utf-8": "off",
    "apple-touch-icons": "off",
    "no-inline-styles": "warning",
    "axe/text-alternatives": "off",
    "axe/aria": "off",
    "axe/color": "off"
  }
}
